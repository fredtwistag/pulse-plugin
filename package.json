{
  "name": "twistag-pulse",
  "version": "0.1.0",
  "private": true,
  "description": "Twistag Pulse — AI-native delivery methodology. Claude Code plugin + self-hosted dashboard.",
  "repository": "https://github.com/fredtwistag/pulse-plugin",
  "license": "MIT",
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter pulse-dashboard dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "plugin:smoke": "pnpm --filter twistag-pulse smoke"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["sharp"]
  }
}
