// Pulse fixture — a tiny but realistic schema mirroring the audit-log epic.
// /db on the dashboard auto-extracts from this file.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String       @id @default(uuid())
  name      String
  createdAt DateTime     @default(now())
  members   Membership[]
  events    AuditEvent[]
}

model User {
  id          String       @id @default(uuid())
  email       String       @unique
  name        String?
  memberships Membership[]
  actions     AuditEvent[]
}

model Membership {
  id             String       @id @default(uuid())
  organizationId String
  userId         String
  role           Role         @default(MEMBER)
  organization   Organization @relation(fields: [organizationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])

  @@unique([organizationId, userId])
}

model AuditEvent {
  id             String       @id @default(uuid())
  organizationId String
  actorId        String
  action         String
  targetId       String?
  targetType     String?
  payload        Json
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id])
  actor          User         @relation(fields: [actorId], references: [id])

  @@index([organizationId, createdAt])
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}
